# BANHAO Driver App — environment template
#
# Copy to `apps/driver/.env` and fill in real values. NEVER commit `.env`.
# See AGENTS.md: no secrets in Git, ever. CI fails the build on a tracked
# `.env`, and the root `.gitignore` already excludes it.
#
# EXPO_PUBLIC_* values are inlined at transform time. After editing this file's
# real counterpart you must restart Metro with `--clear` AND terminate and
# relaunch Expo Go — reloading is not enough.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# ANON key ONLY — safe in a mobile bundle because Row Level Security is what
# protects the data.
#
# SUPABASE_SERVICE_ROLE_KEY must NEVER appear here or anywhere in this app. It
# bypasses RLS entirely and belongs to apps/api alone.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The NestJS API. Required: `POST /api/v1/rider/location` is the only path a
# rider's coordinates can reach the database, so an unset value means the rider
# can never become dispatch-eligible (DEC-037).
#
# On the iOS Simulator, see docs/SUPABASE_DEVELOPMENT.md — the Simulator cannot
# hold HTTP/3 to Supabase and scripts/sim-supabase-proxy.mjs is the workaround.
EXPO_PUBLIC_API_URL=http://localhost:3000
