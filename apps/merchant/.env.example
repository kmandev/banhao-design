# BANHAO Merchant App — environment template
#
# Copy to `apps/merchant/.env.local` and fill in real values. NEVER commit an
# actual `.env.local`. See AGENTS.md: no secrets in Git, ever.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Only ever put non-secret values here — never SUPABASE_SERVICE_ROLE_KEY,
# never any server credential.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# ANON key ONLY — safe in a browser bundle because Row Level Security is what
# protects the data. This app resolves merchant restaurant membership by
# reading `restaurant_members` / `restaurants` directly under RLS
# (restaurant_members_select_member, restaurants_select_member — see
# supabase/migrations/20260811000011_rls_policies.sql).
#
# SUPABASE_SERVICE_ROLE_KEY must NEVER appear here or anywhere in this app. It
# bypasses RLS entirely and belongs to apps/api alone.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The NestJS API. M-1 does not call any write endpoint yet, but the client is
# wired up now so M-2+ (accept/prepare/ready) does not need a second seam.
NEXT_PUBLIC_API_URL=http://localhost:3000
