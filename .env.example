# BANHAO — Environment variable template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# See AGENTS.md: no secrets in Git, ever.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# ANON key — safe to expose to clients (React Native / browser).
# Row Level Security is what protects data when this key is used.
SUPABASE_ANON_KEY=

# SERVICE ROLE key — BACKEND ONLY. Bypasses Row Level Security entirely.
# NEVER expose to React Native, Next.js browser bundles, or any client-side JS.
# Only `apps/api` may read this.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret used to verify Supabase-issued access tokens in apps/api.
# Found in Supabase dashboard under Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# Authenticates POST /internal/tick (DEC-APP-010). BACKEND ONLY — apps/api
# verifies it; the Cloudflare Worker cron (apps/tick-worker, not yet created)
# signs with the same value, stored as a Worker secret, never committed.
INTERNAL_TICK_SECRET=

# Dev-only signing key for NullPaymentProvider's webhook simulator
# (DEC-APP-007). BACKEND ONLY, development use only — leave unset in every
# deployed environment. NullPaymentProvider refuses to start if this is set
# while NODE_ENV=production.
PAYMENT_WEBHOOK_DEV_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare R2 (object storage) — BACKEND ONLY, apps/api/src/modules/storage.
# Optional: nothing calls StorageService yet (no upload endpoint exists to
# authorize a caller before reaching it), so the API starts fine without
# these. Fill them in only once R2 is actually provisioned.
# ---------------------------------------------------------------------------
# Cloudflare account ID.
R2_ACCOUNT_ID=

# R2 API token — access key ID half. NEVER expose to any client bundle.
R2_ACCESS_KEY_ID=

# R2 API token — secret access key half. NEVER expose to any client bundle,
# never EXPO_PUBLIC_/NEXT_PUBLIC_ prefixed, never logged.
R2_SECRET_ACCESS_KEY=

# The BANHAO R2 bucket name.
R2_BUCKET=

# Base public URL objects are served from (a custom domain or R2.dev URL) —
# not the S3 API endpoint. Public objects only; never used for a private key.
R2_PUBLIC_URL=

# The PRIVATE bucket — delivery proof photos (POD) and nothing else.
#
# MUST be a DIFFERENT bucket from R2_BUCKET, and MUST NOT have R2's public
# r2.dev development URL enabled or a custom domain bound to it. Public access
# in R2 is a bucket-level setting, so a proof photo placed in the public bucket
# would be fetchable by anyone holding its key — obscurity, not authorization.
# Proof photos are personal data under PDPA (Q-012).
#
# There is deliberately no matching *_PUBLIC_URL: objects in this bucket are
# only ever reachable through a short-lived signed URL minted per request by
# the API for a caller it has already authorized.
R2_PRIVATE_BUCKET=

# DEC-039 — the POD proof-photo retention purge's on/off switch. Defaults to
# OFF (absent, or anything other than 'true') so a fresh environment never
# starts deleting evidence on its own. The retention windows themselves
# (referenced: 90 days from delivered_at; orphan: 7 days from R2 object
# creation) are DEC-039's approved numbers and are kept as code constants in
# apps/api/src/modules/rider/pod-retention-policy.ts, not here — same
# reasoning DEC-037 already applies to its own dispatch timings: an approved
# business value belongs in the decision log and cited code, not in
# per-environment configuration that can drift with no record of who changed
# it. This flag is the one genuinely operational (not business-value) piece.
#
# DEC-039 records the retention *duration* only. It is not a PDPA lawful-basis
# determination and is not a legal-compliance sign-off — Q-012's lawful-basis
# half remains LEGAL_REVIEW_REQUIRED, and enabling this flag in a real
# deployment is a decision for whoever owns that review, not an engineering
# default.
POD_RETENTION_PURGE_ENABLED=false

# ---------------------------------------------------------------------------
# Database (direct Postgres connection, for migrations/tooling)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# Client-side (Expo) — must be EXPO_PUBLIC_ prefixed to reach the app.
# Only ever put non-secret values here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Client-side (Next.js admin) — NEXT_PUBLIC_ values are bundled into the browser.
# Never put the service role key here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Google Maps Platform
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# ---------------------------------------------------------------------------
FCM_PROJECT_ID=
# Path to a service account JSON file — the FILE ITSELF must never be committed.
FCM_SERVICE_ACCOUNT_PATH=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# NOTE: No payment provider has been selected yet (Q-001 is OPEN).
# apps/api ships a PaymentProvider abstraction with no real implementation.
# When a provider is chosen, its credentials go here — never hardcoded in source.
PAYMENT_PROVIDER=none
